# Base PostgreSQL (Neon via Vercel : renseignée automatiquement sous le nom DATABASE_URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/valises

# Secret de signature des sessions : 32+ caractères aléatoires (ex. `openssl rand -base64 32`)
AUTH_SECRET=

# Adresse(s) des administrateurs, séparées par des virgules
ADMIN_EMAILS=gestionnaire@exemple.fr

# Adresse publique du site (sur Vercel, déduite automatiquement si absente)
APP_URL=http://localhost:3000

# Envoi des e-mails via une boîte existante (ex. Gmail : smtp.gmail.com, port 465, mot de passe d'application)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mallettes pédagogiques <votre.adresse@gmail.com>"

# Protège les tâches planifiées (Vercel l'envoie automatiquement)
CRON_SECRET=

# Mode test en ligne (SMTP absent) : affiche les liens à l'écran. Ne JAMAIS laisser actif pour les écoles.
# TEST_MODE=1
